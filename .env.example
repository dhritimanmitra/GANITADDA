# Copy to .env.local for local development. Never commit real secrets.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
SESSION_SECRET="replace-with-at-least-32-random-characters"
ADMIN_EMAIL="admin@ganitadda.in"
# Generate with: npm run admin:hash -- 'YourStrongPassword'
ADMIN_PASSWORD_HASH="$2b$12$REPLACE_WITH_BCRYPT_HASH"
# Add after connecting Vercel Blob Storage in the Vercel project
BLOB_READ_WRITE_TOKEN=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
